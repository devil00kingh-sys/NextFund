{
  "name": "nxtfund",
  "version": "1.1.0",
  "description": "NXTFund Website & Backend",
  "main": "server.js",
  "scripts": {
    "start": "node -r ./dns-fallback.js server.js",
    "dev": "node -r ./dns-fallback.js server.js",
    "dev:pages": "wrangler pages dev --compatibility-date=2026-08-04 --compatibility-flags nodejs_compat",
    "build": "echo \"Static site - no build step needed\" && exit 0",
    "deploy:pages": "npx wrangler pages deploy . --branch main",
    "seed": "node database/seed.js",
    "r2:create": "npx wrangler r2 bucket create nxtfund-uploads"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "mongodb": "^7.6.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "iconv-lite": "0.6.3"
  }
}
